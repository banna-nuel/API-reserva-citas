								"type": "text/javascript",
								"exec": [
									"// Próximo lunes, siempre en el futuro (si hoy es lunes, el de la semana siguiente), en YYYY-MM-DD",
									"const day = new Date();",
									"const daysUntilMonday = ((8 - day.getDay()) % 7) || 7;      // getDay(): 0 = domingo, 1 = lunes",
									"day.setDate(day.getDate() + daysUntilMonday);",
									"const pad = (n) => String(n).padStart(2, \"0\");",
									"pm.environment.set(\"bookDate\", day.getFullYear() + \"-\" + pad(day.getMonth() + 1) + \"-\" + pad(day.getDate()));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
									"const slots = pm.response.json().slots || [];",
									"pm.test(\"Hay horarios libres\", () => pm.expect(slots.length).to.be.above(0));",
									"if (slots.length > 0) {",
									"    pm.environment.set(\"slotStart\", slots[0].start);",
									"}"
								]
							}
						}
