					"name": "Register",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.environment.set(\"email\", \"cliente\" + Date.now() + \"@mail.test\");"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
									"const body = pm.response.json();",
									"pm.test(\"El rol es CLIENT\", () => pm.expect(body.role).to.eql(\"CLIENT\"));",
									"pm.test(\"Sin password ni passwordHash\", () => {",
									"    pm.expect(body).to.not.have.property(\"password\");",
									"    pm.expect(body).to.not.have.property(\"passwordHash\");",
									"});"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
